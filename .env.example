# =====================================================================
# VARIABLES DE ENTORNO - GEMELO DIGITAL INDUSTRIAL
# =====================================================================

# PostgreSQL / TimescaleDB
POSTGRES_DB=twin
POSTGRES_USER=twin
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
TIMESCALEDB_IMAGE=timescale/timescaledb:2.14.2-pg16

# Broker MQTT (Mosquitto)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MOSQUITTO_IMAGE=eclipse-mosquitto:2.0.18

# Ignition Gateway SCADA
# Imagen oficial Docker Hub: inductiveautomation/ignition:8.1.33
# O imagen local portable v8.3 si se dispone del archivo .tar: ignition-cloud:8.3.3
IGNITION_IMAGE=ignition-cloud:8.3.3
IGNITION_HTTP_PORT=8089
IGNITION_HTTPS_PORT=8043
IGNITION_ADMIN_PASSWORD=change_me_ignition
TIMEZONE=America/Toronto
